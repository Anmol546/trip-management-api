# Normalise line endings on checkin so the repository does not depend on the
# contributor's core.autocrlf setting.
* text=auto eol=lf

*.java text eol=lf
*.sql  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.xml  text eol=lf
*.md   text eol=lf
*.properties text eol=lf
Dockerfile text eol=lf
.gitignore text eol=lf

*.jar binary
*.png binary
*.jpg binary
